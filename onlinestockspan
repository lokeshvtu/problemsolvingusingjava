class StockSpanner {
    Stack<int[]> st;
    int day;

    public StockSpanner() {
        st = new Stack<>();
        day = 0;
    }

    public int next(int price) {
        day++;
        int span = 1;

        while (!st.isEmpty() && st.peek()[0] <= price) {
            span += st.pop()[1];
        }

        st.push(new int[]{price, span});
        return span;
    }
}
